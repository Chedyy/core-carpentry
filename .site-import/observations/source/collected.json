 "form_html": "<section id=\"contact\" class=\"relative bg-[#F9F9F7] py-24 md:py-36\"><div class=\"mx-auto grid max-w-[1400px] gap-0 px-[6vw] lg:grid-cols-2\"><div class=\"relative hidden lg:block overflow-hidden\"><img src=\"https://media.base44.com/images/public/6a594d03167f4fc4143ff173/8dea96064_generated_6fdf2e47.png\" alt=\"Craftsman at work\" class=\"h-full w-full object-cover\"><div class=\"absolute inset-0 bg-gradient-to-t from-[#0F0F0F]/60 to-transparent\"></div><div class=\"absolute bottom-10 left-10 right-10\"><span class=\"label-tech text-[#B98B5F]\">The Consultation Engine</span><h3 class=\"mt-3 display-heading text-3xl text-[#F9F9F7]\">What is the heart of your project?</h3></div></div><div class=\"bg-[#0F0F0F] grain text-[#F9F9F7] p-8 md:p-12\"><div class=\"\" style=\"opacity: 0; transform: translateY(40px);\"><span class=\"label-tech text-[#B98B5F] flex items-center gap-3\"><span class=\"h-px w-8 bg-[#B98B5F]\"></span> Build Request</span></div><div class=\"\" style=\"opacity: 0; transform: translateY(40px);\"><h2 class=\"display-heading mt-5 text-4xl md:text-5xl\">Request a free estimate.</h2></div><form class=\"mt-8 space-y-5\" style=\"opacity: 1;\"><div class=\"grid gap-5 sm:grid-cols-2\"><label class=\"block\"><span class=\"label-tech text-[#F9F9F7]/50 mb-2 block\">Name</span><input required=\"\" class=\"cc-input\" placeholder=\"Jane Doe\" value=\"\" style=\"\"></label><label class=\"block\"><span class=\"label-tech text-[#F9F9F7]/50 mb-2 block\">Phone</span><input class=\"cc-input\" placeholder=\"(555) 000-0000\" value=\"\" style=\"\"></label></div><label class=\"block\"><span class=\"label-tech text-[#F9F9F7]/50 mb-2 block\">Email</span><input required=\"\" type=\"email\" class=\"cc-input\" placeholder=\"jane@email.com\" value=\"\" style=\"\"></label><label class=\"block\"><span class=\"label-tech text-[#F9F9F7]/50 mb-2 block\">Project Type</span><div class=\"flex flex-wrap gap-2\"><button type=\"button\" class=\"label-tech px-3 py-2 border tra